# MongoDB — local by default. For deployment use a free MongoDB Atlas M0 cluster URI.
MONGODB_URI=mongodb://127.0.0.1:27017/nova

# Secret for signing JWTs. REQUIRED (min 32 chars) — the server refuses to start without it. `openssl rand -hex 32`
# Set NODE_ENV=production when deploying (drops the localhost CORS origins).
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# HTTP port (default 4000)
PORT=4000

# LLM provider: mock | groq | gemini | openrouter | ollama
# If LLM_API_KEY is empty, the server uses the built-in rule-based "mock" provider (works offline, ₹0).
LLM_PROVIDER=mock
LLM_API_KEY=
# Optional model override (defaults: groq=openai/gpt-oss-120b, gemini=gemini-2.0-flash,
# openrouter=meta-llama/llama-3.3-70b-instruct:free, ollama=llama3.1)
LLM_MODEL=
# Models tried in order when the main one is rate-limited (each has its own free-tier token bucket).
# Default for groq: openai/gpt-oss-20b,qwen/qwen3.8-27b
# LLM_FALLBACK_MODELS=
# Vision model for receipt scanning (default groq: qwen/qwen3.8-27b). Without one, local OCR is used.
# LLM_VISION_MODEL=
# Speech-to-text model for /api/transcribe (Groq only)
# STT_MODEL=whisper-large-v3-turbo
# Provider calls per user per UTC day (agent LLM calls, receipt vision, Whisper). Default 200.
# LLM_DAILY_CALL_LIMIT=200
# Overall deadline for one /api/agent request in ms (all iterations, fallbacks and retries). Default 45000.
# AGENT_DEADLINE_MS=45000
# Optional base URL override for any OpenAI-compatible endpoint
# LLM_BASE_URL=

# Extra allowed CORS origins, comma-separated (localhost:3000 and :8081 are always allowed)
CORS_ORIGINS=
