# MongoDB — local by default. For deployment use a free MongoDB Atlas M0 cluster URI.
MONGODB_URI=mongodb://127.0.0.1:27017/nova

# Secret for signing JWTs. REQUIRED in production — use a long random string (e.g. `openssl rand -hex 32`).
JWT_SECRET=change-me-to-a-long-random-string

# HTTP port (default 4000)
PORT=4000

# LLM provider: mock | groq | gemini | openrouter | ollama
# If LLM_API_KEY is empty, the server uses the built-in rule-based "mock" provider (works offline, ₹0).
LLM_PROVIDER=mock
LLM_API_KEY=
# Optional model override (defaults: groq=llama-3.3-70b-versatile, gemini=gemini-2.0-flash,
# openrouter=meta-llama/llama-3.3-70b-instruct:free, ollama=llama3.1)
LLM_MODEL=
# Optional base URL override for any OpenAI-compatible endpoint
# LLM_BASE_URL=

# Extra allowed CORS origins, comma-separated (localhost:3000 and :8081 are always allowed)
CORS_ORIGINS=
